data_dir = "data"
ai_config = "env.toml"
generation_model = "generation"
decision_model = "decision"
kb_url = "http://127.0.0.1:8000"
kb_headers = {}
allowed_hosts = ["127.0.0.1", "localhost"]
scope_paths = []
exclude_paths = []
search_mode = "hybrid"
candidate_limit = 5
necessity_threshold = 0.5
timeout_seconds = 180
retry_count = 1
concurrency = 2
max_files = 10
max_file_bytes = 10485760
max_expanded_bytes = 52428800
max_spreadsheet_cells = 200000
max_input_chars = 120000
max_document_chars = 120000
max_input_tokens = 50000