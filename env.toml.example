[auth]
type = "api_key"

[[models]]
name = "generation"
endpoint = "https://your-resource.openai.azure.com/openai/v1/"
deployment = "your-generation-deployment"
api_key = "your-api-key"
context_window = 128000
max_output_tokens = 16384
read_timeout = 180
# 100万トークンあたりの USD。契約単価を設定（未設定なら未計上）。
# input_token_cost = ...
# output_token_cost = ...

[[models]]
name = "decision"
provider = "foundry"
endpoint = "https://your-resource.services.ai.azure.com"
deployment = "your-microsoft-decision-1-deployment"
api_key = "your-api-key"
context_window = 128000
read_timeout = 180
# Decision-1 は入力のみ。
# input_token_cost = ...